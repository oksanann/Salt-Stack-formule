security-baseline:
  # Override map.jinja defaults
  lookup:
    # Feature toggles
    enable_ssh: True
    enable_sysctl: True
    enable_services: True
    enable_packages: True

    ssh:
      # Managed drop-in (clean removes this file only)
      config_path: '/etc/ssh/sshd_config.d/99-security-baseline.conf'
      service: 'ssh'   # RedHat override in map.jinja -> sshd
      permit_root_login: 'no'
      password_authentication: 'no'
      pubkey_authentication: 'yes'
      challenge_response_authentication: 'no'
      use_pam: 'yes'
      x11_forwarding: 'no'
      max_auth_tries: 3
      client_alive_interval: 300
      client_alive_count_max: 2
      allow_users: []          # e.g. ['admin', 'deploy']
      allow_groups: []         # e.g. ['sshusers']
      protocol: 2

    sysctl:
      config_path: '/etc/sysctl.d/99-security-baseline.conf'
      params:
        net.ipv4.ip_forward: 0
        net.ipv4.conf.all.accept_redirects: 0
        net.ipv4.conf.default.accept_redirects: 0
        net.ipv4.conf.all.send_redirects: 0
        net.ipv4.conf.default.send_redirects: 0
        net.ipv4.conf.all.accept_source_route: 0
        net.ipv4.conf.default.accept_source_route: 0
        net.ipv4.conf.all.log_martians: 1
        net.ipv4.icmp_echo_ignore_broadcasts: 1
        net.ipv4.tcp_syncookies: 1
        net.ipv6.conf.all.accept_redirects: 0
        net.ipv6.conf.default.accept_redirects: 0
        kernel.randomize_va_space: 2
        fs.suid_dumpable: 0

    services:
      # Stop and disable these services if present
      disabled:
        - telnet.socket
        - telnet
        - rsh.socket
        - rlogin.socket
        - rexec.socket
        - nfs-server
        - rpcbind
        - avahi-daemon
        - cups
        - bluetooth

    packages:
      # Install if missing
      required: []
      # Remove if present (use carefully)
      forbidden:
        - telnet
        - rsh-client
        - rsh-redone-client
        - talk
        - xinetd
